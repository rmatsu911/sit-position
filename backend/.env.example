# ===== Backend 環境変数（.env にコピーして使用。秘密情報はコミットしない） =====

# Database
DATABASE_URL=postgresql+psycopg2://sysken:sysken@localhost:5432/sysken

# JWT（本番では十分に長いランダム値へ差し替えること）
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS（フロントエンドのオリジン。カンマ区切り）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ファイルストレージ: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# S3 / MinIO（STORAGE_BACKEND=s3 のとき使用）
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sysken

# 初期管理者（seed で作成）
SEED_ADMIN_EMAIL=admin@example.co.jp
SEED_ADMIN_PASSWORD=Passw0rd!
